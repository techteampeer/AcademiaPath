# AcademiaPath environment example — NON-SECRET values only.
# Copy to `.env` in the repository root for local overrides. Never commit `.env`.
# Real secrets (database credentials, API keys) will be provided via
# Google Cloud Secret Manager in later tasks, never through this file.

# --- API (apps/api) ---
# Use 0.0.0.0 when running inside a container.
API_HOST=127.0.0.1
API_PORT=4000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Database (apps/api) ---
# Local development PostgreSQL only — never the institutional database.
# Add a user/password only in your uncommitted .env.
DATABASE_URL=postgresql://localhost:5432/academiapath_dev

# --- Authentication (apps/api) ---
# Comma-separated browser origins allowed to make state-changing requests (required in production).
APP_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=8
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Behind a proxy/load balancer, list the proxies' IPs/CIDRs (comma-separated); X-Forwarded-For is
# then honored only from those peers. "true" and hop counts are rejected (spoofable/unverifiable).
TRUST_PROXY=false

# --- Tutor (apps/api) ---
# Local mock provider only; no AI service or API key is used. Requests per user and course per window.
TUTOR_RATE_LIMIT_MAX=20
TUTOR_RATE_LIMIT_WINDOW_MINUTES=10

# --- Course documents (apps/api) ---
# Private storage for uploaded originals: an absolute path OUTSIDE the repository (required in
# production). Development default: ~/.academiapath/documents
# DOCUMENT_STORAGE_DIR=/var/lib/academiapath/documents
# Upload size limit in MB (the web proxy reads the same value to forward bodies up to this size).
DOCUMENT_MAX_UPLOAD_MB=10
# Hard time limit for validating and extracting one document.
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=20
# No malware scanning service is connected yet; uploads are recorded as not_scanned.

# --- User accounts (apps/api) ---
# New accounts have no password; users set one through a single-use activation link.
# local_link: the link is shown once to the administrator, for synthetic addresses only (.example,
# .test, ...). Development default. Refused in production, where the default is disabled until a
# secure delivery and identity-verification mechanism exists.
# ACCOUNT_INVITATION_DELIVERY=local_link
# Hours until an activation link expires (1-168).
ACCOUNT_INVITATION_TTL_HOURS=72

# --- Web (apps/web) ---
# Where the Next.js same-origin proxy forwards /api/* (server-side only; never exposed to the
# browser). Next.js reads it from the process environment or apps/web/.env.local.
# API_ORIGIN=http://127.0.0.1:4000

# --- Development-only synthetic users (pnpm db:seed:dev) ---
# Choose your own local value (12+ characters) in .env. Never commit it.
# DEV_SEED_PASSWORD=
