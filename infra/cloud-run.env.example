# AcademiaPath on Cloud Run — environment reference (NO real values, NO secrets).
#
# This file documents every variable the deployed services receive and where each one comes from.
# Local development uses the root `.env.example` instead. The source of truth for what is actually
# deployed is `.github/workflows/deploy.yml`; keep this file in sync when you change it.
#
#   [env]     plain environment variable, set by `gcloud run deploy --set-env-vars` in deploy.yml
#   [secret]  value lives in Google Cloud Secret Manager, mounted with `--set-secrets` (never in Git)
#   [build]   Docker build argument, fixed into the image at build time
#
# Project: elearning-514315 · Region: us-central1 · every resource is prefixed `academiapath` and
# labelled app=academiapath (the ITIL platform in the same project uses the `itil-` prefix).

# =====================================================================================
# academiapath-api  (Cloud Run service, Dockerfile target `api`, runs as academiapath-runtime)
# =====================================================================================

# [secret] academiapath-db-url — PostgreSQL through the Cloud SQL Unix socket (instance academiapath-db).
# Shape only; the real user/password were generated by infra/setup-demo.sh and are never printed.
DATABASE_URL=postgresql://academiapath_app:<password>@localhost/academiapath?host=/cloudsql/elearning-514315:us-central1:academiapath-db

# [env] Required in production: enables Secure __Host- session cookies and production-only checks.
NODE_ENV=production
# [env] Listen on every interface inside the container. PORT is injected by Cloud Run (8080);
# do not set API_PORT on Cloud Run.
API_HOST=0.0.0.0
# [env] fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# [env] Browser origins allowed to make state-changing requests = the web service URL.
APP_ORIGINS=https://academiapath-web-871079669510.us-central1.run.app
# [env]
SESSION_TTL_HOURS=8
# [env] Cloud Storage bucket elearning-514315-academiapath-files, mounted as a volume at this path
# (Cloud Run's own disk is wiped on every restart).
DOCUMENT_STORAGE_DIR=/mnt/documents
# [env] Keep equal on the API and the web proxy.
DOCUMENT_MAX_UPLOAD_MB=10

# Not set on Cloud Run today (code defaults apply; add to deploy.yml if you need to change them):
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# TUTOR_RATE_LIMIT_MAX=20
# TUTOR_RATE_LIMIT_WINDOW_MINUTES=10
# DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=20
# ACCOUNT_INVITATION_TTL_HOURS=72
# ACCOUNT_INVITATION_DELIVERY  -> production allows only `disabled` (the default) until secure delivery exists
# TRUST_PROXY=false            -> requests arrive through the web proxy; see "Known limitations" in PR #23
# INSTITUTION_TIME_ZONE=America/Lima  -> calendar default time zone (AP-025); the default is America/Lima

# =====================================================================================
# academiapath-migrate  (Cloud Run job, Dockerfile target `migrate`, runs before every API deploy)
# =====================================================================================

# [secret] same secret as the API
# DATABASE_URL=academiapath-db-url

# =====================================================================================
# academiapath-seed-demo  (Cloud Run job, Dockerfile target `migrate`, run by hand only; see infra/README.md)
# Defined and executed by .github/workflows/seed-demo.yml (workflow_dispatch only), never by deploy.yml.
# =====================================================================================

# [secret] same secret as the API
# DATABASE_URL=academiapath-db-url
# [secret] academiapath-demo-credentials — JSON {"<email>": "<password>"} for the five demo role accounts,
# created by infra/demo-credentials.sh. Never printed by the job.
# DEMO_ACCOUNT_CREDENTIALS=academiapath-demo-credentials
# [env] as for the API
# NODE_ENV=production
# APP_ORIGINS=https://academiapath-web-871079669510.us-central1.run.app
# DOCUMENT_STORAGE_DIR=/mnt/documents          (the documents bucket, mounted as for the API)
# DOCUMENT_MAX_UPLOAD_MB=10
# LOG_LEVEL=warn
# [env] the seed's own switches
# DEMO_SEED_TARGET=cloud-demo
# DEMO_SEED_MODE=check                          (job default; create / reset-credentials per execution)
# DEMO_SEED_CONFIRM=academiapath-demo           (per execution, required for create and reset-credentials)
# DEMO_SEED_CONFIRM_RESET=reset-demo-credentials (per execution, required for reset-credentials)

# =====================================================================================
# academiapath-web  (Cloud Run service, Dockerfile target `web`, port 3000)
# =====================================================================================

# [build] + [env] Where the Next.js proxy forwards /api/*. Next.js fixes rewrites at build time, so
# deploy.yml passes it as a build argument AND as a runtime variable. Server-side only.
API_ORIGIN=https://academiapath-api-871079669510.us-central1.run.app
# [env]
NODE_ENV=production
# [env] Must match the API value (the proxy forwards bodies up to this size + 2 MB).
DOCUMENT_MAX_UPLOAD_MB=10

# =====================================================================================
# GitHub Actions (repository secrets, not environment variables)
# =====================================================================================

# GCP_SA_KEY  JSON key of academiapath-deployer@elearning-514315.iam.gserviceaccount.com
#             (roles: run.admin, artifactregistry.writer on repo `academiapath`, serviceAccountUser on
#             academiapath-runtime). Prefer replacing it with Workload Identity Federation.

# =====================================================================================
# Planned (not wired yet)
# =====================================================================================

# Firebase Authentication on Identity Platform (see the functional spec, section Authentication).
# Web, public config, safe to expose — [build]:
#   NEXT_PUBLIC_FIREBASE_API_KEY=
#   NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=elearning-514315.firebaseapp.com
#   NEXT_PUBLIC_FIREBASE_PROJECT_ID=elearning-514315
#   NEXT_PUBLIC_FIREBASE_APP_ID=
# API: no key needed; the Firebase Admin SDK uses academiapath-runtime through Application Default
# Credentials (role roles/firebaseauth.admin).
#
# Vertex AI for the tutor and document summaries (the API uses a local mock provider today) — [env]:
#   GOOGLE_CLOUD_PROJECT=elearning-514315
#   VERTEX_LOCATION=us-central1
#   VERTEX_MODEL=<stable Gemini Flash model id>
